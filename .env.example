# ---- Core ----
PORT=8080
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tapswap

# JWT signing secret (used for auth + transfer tokens)
JWT_SECRET=change-me

# ---- Redis (BullMQ) ----
# Option A: a single connection URL from a hosted Redis provider
#   (Upstash, Redis Cloud, Aiven, Railway, Render, ...).
#   Use the rediss:// scheme to enable TLS.
# REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379

# Option B: discrete variables (used only when REDIS_URL is not set).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=true

# ---- Payaza (top-up provider) ----
PAYAZA_BASE_URL=https://api.payaza.africa
PAYAZA_PUBLIC_KEY=
PAYAZA_SECRET_KEY=

# ---- Firebase Cloud Messaging (push notifications) ----
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Cloudflare R2 / S3 (uploads) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- SMTP (support emails) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Misc ----
EXTERNAL_API_TOKEN=
